rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ GEÇİCİ MİMARİ NOTU
    // Bu dosya, Blaze faturalandırma planı aktif olana kadar Cloud Functions'sız
    // çalışabilmek için gevşetildi. Orijinal (Cloud Functions'ın tüm yazma işlemlerini
    // tekelinde tuttuğu, daha güvenli) hali `firestore.rules.cloudfunctions-backup`
    // dosyasında duruyor. Blaze aktif olup `firebase deploy --only functions`
    // çalıştırıldığında, o dosyanın içeriğini buraya geri kopyala.

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      // GEÇİCİ: blockedUids artık client (ModerationService) tarafından doğrudan
      // yazılıyor — yalnızca kendi belgesini güncelleyebilir.
      allow update: if isSignedIn() && request.auth.uid == uid;
    }

    // trips/{tripId} — GEÇİCİ: client doğrudan yazıyor (TripService).
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Sahibi güncelleyebilir (örn. güzergah/plannedWaypoints güncellemesi).
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // documentClaims/{hash} — biniş kartı/rezervasyon belgesi tekillik kayıtları.
    // "allow update: if false" kritik: bir kez oluşturulan kayıt hiçbir client
    // tarafından üzerine yazılamaz, bu da aynı belgenin ikinci bir hesapla
    // kullanılmasını engeller (bkz. TripService.submitTrip transaction'ı).
    match /documentClaims/{hash} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // blocks/{blockerUid_blockedUid} — GEÇİCİ: client doğrudan yazıyor (ModerationService).
    match /blocks/{blockId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // reports/{reportId} — moderasyon kayıtları, yalnızca oluşturan yazabilir,
    // hiç kimse (raporu açan dahil) okuyamaz/değiştiremez.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // matches/{matchId} — GEÇİCİ: client doğrudan yazıyor (MatchService).
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.initiatedBy == request.auth.uid
        && request.resource.data.status == "pending";
      // Taraflardan biri durumu günceller (kabul/red) ya da engelleme sonucu "blocked" yapar.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == "accepted"
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
