rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MİMARİ NOTU
    // Cloud Functions kullanılmıyor (Blaze planı açılamadı). Client doğrudan
    // yazıyor, bu yüzden sunucu tarafında yapılan kontrollerin bir kısmı
    // buraya taşındı. Sunucu gerektiren üç iş Supabase Edge Functions'a
    // taşınacak: uçuş doğrulama, push bildirimi, zamanlanmış temizlik.
    //
    // Fonksiyonların tüm yazmayı tekelinde tuttuğu sıkı sürüm:
    // firestore.rules.cloudfunctions-backup
    //
    // BİLİNEN SINIR: "isVerified" rozeti oluşturma anında client'ın sözüne
    // dayanıyor (biniş kartı cihazda taranıyor). Edge Function geldiğinde bu
    // alan yalnızca sunucudan yazılacak şekilde kilitlenmeli.

    function isSignedIn() {
      return request.auth != null;
    }

    // Bir alanın değişmediğini doğrular (yoksa varsayılanla karşılaştırır).
    function unchanged(field, def) {
      return request.resource.data.get(field, def) == resource.data.get(field, def);
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;

      allow delete: if false;
    }

    // trips/{tripId}
    match /trips/{tripId} {
      allow read: if isSignedIn();

      // isVerified yalnızca belge doğrulamasıyla ve hash varsa true olabilir.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (
             request.resource.data.get('isVerified', false) == false
             || (
                  request.resource.data.get('verificationMethod', '') == 'document'
                  && request.resource.data.get('documentHash', null) != null
                )
           );

      // Sahibi güncelleyebilir (örn. plannedWaypoints), ama sahipliği ve
      // doğrulama durumunu değiştiremez.
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchanged('ownerUid', '')
        && unchanged('isVerified', false)
        && unchanged('documentHash', null)
        && unchanged('verificationMethod', '')
        // Güzergah en fazla 10 durak.
        && request.resource.data.get('plannedWaypoints', []).size() <= 10;

      // Hesap silme akışı kendi seyahatlerini temizleyebilmeli (5.1.1(v)).
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // trips/{tripId} giriş yapan herkese açık (eşleşme için gerekli). Bu yüzden
    // PNR / rezervasyon kodu ORADA TUTULMAZ — yalnızca sahibinin okuyabildiği
    // ayrı bir koleksiyonda durur. Firestore alan bazlı izin veremediği için
    // hassas veriyi ayırmak tek yol.
    match /tripSecrets/{tripId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && unchanged('ownerUid', '');
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // users/{uid} de herkese açık okunuyor (ad, yaş, bio eşleşme kartında
    // gösteriliyor). Push token'ı ve engelleme listesi bu yüzden orada değil,
    // burada — yalnızca sahibi erişebilir.
    match /userSecrets/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // documentClaims/{hash} — biniş kartı / rezervasyon belgesi tekilliği.
    // create, var olan bir belgeye yapıldığında Firestore tarafından
    // otomatik reddedilir; update/delete kapalı olduğu için bir kez
    // yazılan kayıt asla başka bir hesaba geçemez.
    match /documentClaims/{hash} {
      // Cloud Functions yokken tekillik kontrolünü client yapıyor
      // (TripService transaction içinde okuyor), bu yüzden okuma açık.
      // Kayıt yalnızca hash'i zaten elinde olan biri için anlamlı.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // blocks/{blockerUid_blockedUid}
    match /blocks/{blockId} {
      // MatchService istek göndermeden önce iki yönlü engelleme kontrolü
      // yapıyor — okuma kapalıyken bu sorgu permission-denied veriyor ve
      // eşleşme isteği hiç oluşturulamıyor.
      // Not: users/{uid}.blockedUids zaten giriş yapmış herkese okunabilir,
      // dolayısıyla bu izin yeni bir bilgi açığa çıkarmıyor.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // reports/{reportId} — yalnızca oluşturulabilir, hiç kimse okuyamaz.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // matches/{matchId}
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.initiatedBy == request.auth.uid
        && request.resource.data.status == "pending";

      // KRİTİK: isteği gönderen kendi isteğini kabul edemez.
      // Kabul/red yalnızca karşı taraftan gelebilir. Engelleme her iki
      // taraftan gelebilir. Taraflar ve tripId hiç değişemez.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && unchanged('participants', [])
        && unchanged('initiatedBy', '')
        && unchanged('tripId', '')
        && (
             // Durum değişmiyorsa (örn. son okuma zamanı güncellemesi) serbest.
             request.resource.data.status == resource.data.status
             // Engelleme: her iki taraf da yapabilir.
             || request.resource.data.status == "blocked"
             // Kabul/red: yalnızca isteği ALAN taraf, ve yalnızca beklemedeyken.
             || (
                  request.resource.data.status in ["accepted", "rejected"]
                  && resource.data.status == "pending"
                  && request.auth.uid != resource.data.initiatedBy
                )
           );

      // Hesap silme akışı için: taraflardan biri eşleşmeyi silebilir.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function match_() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        allow read: if isSignedIn()
          && request.auth.uid in match_().participants;

        allow create: if isSignedIn()
          && request.auth.uid in match_().participants
          && match_().status == "accepted"
          && request.resource.data.senderUid == request.auth.uid;

        allow update: if false;
        // Hesap silinirken sohbet geçmişi de gitmeli.
        allow delete: if isSignedIn() && request.auth.uid in match_().participants;
      }
    }
  }
}
